prefix=/home/as/Desktop/LinuxEmbeddedWithBBB_Ver2/wayland/code/wlroots_src/wlroots-0.20.2
includedir=${prefix}/include
libdir=${prefix}/lib

have_drm_backend=true
have_x11_backend=false
have_libinput_backend=true
have_xwayland=false
have_gles2_renderer=true
have_vulkan_renderer=true
have_gbm_allocator=true
have_udmabuf_allocator=true
have_session=true
have_color_management=true

Name: wlroots-0.20
Description: Wayland compositor library
URL: https://gitlab.freedesktop.org/wlroots/wlroots
Version: 0.20.2
Requires.private: wayland-server >= 1.24.0, libdrm >= 2.4.129, xkbcommon >= 1.8.0, pixman-1 >= 0.43.0, wayland-protocols >= 1.47, egl, gbm, glesv2, vulkan >= 1.2.182, lcms2, libudev, libseat >= 0.2.0, libdisplay-info >= 0.2.0, libliftoff >= 0.4.0, libinput >= 1.19.0, wayland-client >= 1.24.0
Libs: -L${libdir} -lwlroots-0.20
Libs.private: -lm -lrt
Cflags: -I${includedir}/wlroots-0.20
