{
    "explorer.excludeGitIgnore": false,
    "files.exclude": {
        "**/.*.cmd": true,
        "**/.*.d": false,
        "**/*.o": true,
        "**/*.mod": true,
        "**/*.mod.c": true,
        "**/modules.order": true,
        "**/Module.symvers": true,
        "**/.clangd": true,
        "**/.cache": true,
        "**/node_modules": true,
        "**/dist": true,
    },
    "files.watcherExclude": {
        "**/bootlin/linux-kernel/linux-kernel-bbb-labs/src/linux/**": true,
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/*/**": true,
        "**/arch/x86/**": true,
        "**/arch/mips/**": true,
        "**/arch/powerpc/**": true,
        "**/documentation/**": true,
        "**/tools/**": true,
        "**/node_modules/**": true,
        "**/dist/**": true,
        "**/build/**": true,
        "**/.vscode/**": true
    },
    "editor.formatOnSave": true,
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.tabSize": 4,
        "editor.insertSpaces": false,
        "editor.detectIndentation": false,
        "editor.formatOnSave": true
    },
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
        "editor.tabSize": 4,
        "editor.insertSpaces": false,
        "editor.detectIndentation": false,
        "editor.formatOnSave": true
    },
    "markdown.copyFiles.destination": {
        "**/*": "images/"
    },
    "git.autorefresh": false,
    "markdown.copyFiles.overwriteBehavior": "nameIncrementally",
    "gnuGlobal.objDir": "${workspaceFolder}/bootlin/linux-kernel/linux-kernel-bbb-labs/src/linux",
    "C_Cpp.default.compilerPath": "/home/as/x-tools/arm-bootlin-linux-gnueabihf/bin/arm-bootlin-linux-gnueabihf-gcc",
    "clangd.arguments": [
        "--header-insertion=never"
    ],
    "editor.inlayHints.enabled": "on",
    "clangd.inlayHints.parameterNames": true,
    "clangd.inlayHints.designators": true,
    "C_Cpp.inlayHints.parameterNames.enabled": true,
    "C_Cpp.inlayHints.parameterNames.suppressWhenArgumentMatchesName": false
}